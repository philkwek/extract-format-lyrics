rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared-set records are accessed exclusively by the Cloud Function using
    // Admin credentials. Browser clients must never read or write them directly.
    match /{document=**} {
      allow read, write: if false;
    }

    // Live shares: browsers may get one by its unguessable id, never list or write.
    match /liveSets/{id} {
      allow get: if resource.data.expiresAt > request.time;
    }
    match /liveSetSongs/{docId} {
      allow get: if resource.data.expiresAt > request.time;
    }

    // Lyrics links: browsers may listen to the publication summary, never list or write.
    match /sharedLyrics/{id} {
      allow get: if resource.data.expiresAt > request.time;
    }
  }
}
