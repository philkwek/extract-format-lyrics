{
  "name": "extract-format-lyrics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run build --prefix functions && firebase emulators:start --only functions --project demo-chords",
    "dev:all": "concurrently -n \"functions,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "build:functions": "npm run build --prefix functions",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test": "vitest run --passWithNoTests",
    "test:functions": "npm run test --prefix functions",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.0.0",
    "idb-keyval": "^6.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
