# Browser Firebase configuration (public identifiers, never service account keys).
# Local development and PR previews do not collect Analytics.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_HOSTNAMES=extract-format-lyrics.web.app,extract-format-lyrics.firebaseapp.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=extract-format-lyrics
VITE_FIREBASE_MEASUREMENT_ID=

# Local Firestore emulator (npm run dev:all). Copy these into .env.local, not here.
# The project id must match the emulator project, demo-chords.
# VITE_FIREBASE_PROJECT_ID=demo-chords
# VITE_FIREBASE_API_KEY=demo-key
# VITE_FIREBASE_APP_ID=demo-app
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
