# Browser Firebase configuration (public identifiers, never service account keys).
# Local development and PR previews do not collect Analytics.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_HOSTNAMES=extract-format-lyrics.web.app,extract-format-lyrics.firebaseapp.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=extract-format-lyrics
VITE_FIREBASE_MEASUREMENT_ID=
